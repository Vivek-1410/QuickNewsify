<% layout("/layouts/boilerplate") %>
<body>
  <div class="container py-5 min-vh-100" style="margin-top: 50px;" >
    <div class="row justify-content-center">
      <div class="col-md-8">
        <h3 class="mb-4 text-center">Edit Your Note</h3>
        <form action="/user/edit-note/<%= note._id %>" method="POST">
          <div class="form-group mb-3">
            <textarea name="content" rows="6" class="form-control"><%= note.content %></textarea>
          </div>
          <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-primary">Update Note</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
