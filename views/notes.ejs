<% layout("/layouts/boilerplate") %>
<body>
    <div class="d-flex flex-column min-vh-100">
        <div class="container py-5 flex-grow-1">
            <div class="d-flex justify-content-center mb-4">
                <button class="btn btn-success w-50 fw-normal">Saved Notes</button>
            </div>
            <% if (notes.length === 0) { %>
                <div class="alert alert-warning text-center" role="alert">
                    No saved notes yet. Start adding some!
                </div>
            <% } else { %>
                <ul class="list-group notes-list">
                    <% notes.forEach(note => { %>
                        <li class="list-group-item shadow-sm p-3 mb-3 bg-white rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><%= note.content %></span>
                                <div>
                                    <a href="/user/edit-note/<%= note._id %>" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-pen"></i></a>
                                    <form action="/user/delete-note/<%= note._id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </div>
    </div>

    <style>
        .container {
            margin-top: 2rem;
            flex-grow: 1;
        }

        .notes-list {
            max-width: 800px;
            margin: 0 auto;
        }

        h1 {
            color: #07931c;
            font-weight: bold;
        }

        button {
            max-width: 300px;
        }
    </style>
</body>
