<% layout("/layouts/boilerplate") -%>

<body>
    <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="card p-4 shadow-lg rounded login-container">
            <h2 class="text-center text-danger mb-4">Forgot Password</h2>
            <form method="POST" action="/user/forgot-password">
                <div class="form-group mb-3">
                    <label for="email">Enter your registered email:</label>
                    <input type="email" class="form-control" name="email" id="email" required>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-danger w-100">Send Reset Link</button>
                </div>
            </form>
        </div>
    </div>
</body>
